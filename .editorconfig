# Top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true

# JavaScript source and tests
[*.{js,mjs,cjs,ts}]
indent_style = space
indent_size = 4
insert_final_newline = true

# JSON files
[*.json]
indent_style = space
indent_size = 2
insert_final_newline = true

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2
insert_final_newline = true

# Markdown keeps trailing spaces for hard line breaks
[*.md]
trim_trailing_whitespace = false

{
  "name": "kind-js",
  "version": "0.5.0",
  "description": "A simple, dependency-free type-checking utility for JavaScript",
  "keywords": [
    "kind",
    "kindjs",
    "kindof",
    "typeof",
    "type",
    "type-check",
    "check",
    "utility",
    "umd",
    "esm",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Jeff Rose",
    "email": "jefuri.rozu@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffrose/kind-js.git"
  },
  "homepage": "https://github.com/jeffrose/kind-js",
  "bugs": {
    "url": "https://github.com/jeffrose/kind-js/issues"
  },
  "main": "kind.js",
  "module": "kind.mjs",
  "types": "kind.d.ts",
  "unpkg": "kind.js",
  "jsdelivr": "kind.js",
  "exports": {
    ".": {
      "types": "./kind.d.ts",
      "import": "./kind.mjs",
      "require": "./kind.js",
      "default": "./kind.js"
    },
    "./kind.js": "./kind.js",
    "./kind.mjs": "./kind.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "kind.js",
    "kind.mjs",
    "kind.d.ts",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/behavior.test.js test/api.test.js test/regressions.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/behavior.test.js test/api.test.js test/regressions.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
